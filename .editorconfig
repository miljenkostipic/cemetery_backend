root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csproj,json,yml,yaml}]
indent_size = 4

[*.cs]
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1812.severity = none

[**/Migrations/**.cs]
dotnet_diagnostic.CA1861.severity = none
